    margin: 0 var(--S-);
    margin-bottom: var(--S-);
    max-width: 50%;
  }


  .card {
    display: grid;
    margin-bottom: var(--M-);
    gap: var(--L-);
  }

  .places {
    display: flex;
    flex-wrap: wrap;
    gap: var(--XS-);
    justify-content: center;
  }

  @media (min-width: 800px) {

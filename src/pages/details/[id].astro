const data = await fetch(endpoint, options).then((responsive) => responsive.json());
console.log(data);

export async function getStaticPaths() {
const endpoint = "https://ffbiajyenlsazjzqyxoa.supabase.co/rest/v1/dankort?select=*"

const options={
    headers:{
        apikey: "sb_publishable_6KKNQDlVMGuCo-exwQav1g_cIj-qroR"
    }
}
  const response = await fetch(endpoint, options);
  const data = await response.json();

  return data.map((dankort) => {
    return {
      params: { id: dankort.id.toString() },
      props: { dankort },
    };
  });
}

const { id } = Astro.params
const { dankort } = Astro.props;
---
<Layout>
 <Carddetails dankort = {dankort}/>
 <section class="card">
  {data.map((dankort) => <Cardapi {dankort} />)}
</section>
<div class="tree">
<img src="/assets/SVG/filtrering_desktop/planter_filtrering_desktop.svg" alt="Svg af planter">
</div>
  </Layout>

  <style>
  section {
    margin: 0 var(--S-);
    margin-top: var(--M-);
  }

  .tree {
  display: flex;

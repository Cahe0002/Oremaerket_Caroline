---
const {title,href, target = "_self"} = Astro.props;
---

<a href={href} class="button" target={target}>
  {title}
</a>

<style>
.button {
  display: flex;
  justify-content: center;
  align-items: center;

  width: 195px;
  height: 59px;

  font-weight: bold;
  text-decoration: none;

  border-radius: 20px;
  color: var(--dankort-hvid);
  background: var(--dankort-roed);

  cursor: pointer;
}

.button:hover {
  background-color:#BD191C;
}
</style>
---
const {title,href, target = "_self", variant} = Astro.props;
---

<a href={href} class={variant} target={target}>
  {title}
</a>

<style>
a {
  display: flex;
  justify-content: center;
  align-items: center;

  width: 195px;
  height: 59px;

  font-weight: bold;
  text-decoration: none;

  border-radius: 20px;
  color: var(--dankort-hvid);
  background: var(--dankort-roed);

  cursor: pointer;
}

a:hover {
  background-color:#BD191C;
}

.secondary {
margin-top: var(--L-)
}
</style>
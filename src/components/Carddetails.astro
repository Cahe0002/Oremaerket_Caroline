---
const { dankort } = Astro.props;
import Button from "./Button.astro";
---

<section>
    <div>
        <div>
    <img src={dankort.image} alt={dankort.place} fetchpriority="high" class="imgdetails">
    </div>
    </div>
    <div>
   <h1 class="h1">{dankort.place} - {dankort.city}</h1>
   <p class="p">{dankort.text_1}</p>
   <p class="p">{dankort.text_2}</p>
   <p class="p">{dankort.text_3}</p>
   
   <Button variant="secondary" title= "GÅ TIL NATURFONDEN" href={dankort.link} target="_blank"></Button>
     <!-- <div class="small">
    <img src={dankort.img_1} alt={dankort.place} class="imgsmall">
    <img src={dankort.img_1} alt={dankort.place} class="imgsmall">
    <img src={dankort.img_1} alt={dankort.place} class="imgsmall">
    </div> -->
   </div>
</section>

<section class="others">
    <h2 class="h2">Andre kiggede på</h2>
</section>


<style>
    section{
        display: grid;
        margin: 0 var(--S-);
        margin-top: var(--M-);
    }

    .tree {
  display: flex;
  flex-direction: row;
  justify-content: end;

}

.p {
    margin-bottom: var(--S-);
}

    .beesvg {
        display: none;
    }

    .imgdetails {
        border-radius: 20px;
        width: 100%;
        height: auto;
        object-fit: cover;
    }

    .imgsmall {
        border-radius: 20px;
    }
    


        
 @media (min-width: 1024px) {

    section {
    grid-template-columns: repeat(2, 1fr);
    margin: 0 120px;
    margin-top: var(--L-);
    margin-bottom: var(--L-);
        
            }

              .others{
        margin-bottom: 0px;
    }
    

        .beesvg {
                position: absolute;
                 top: 20rem;
                 left: 10rem;
                 transform: translate(100%, 100%);
                 z-index: 1;
                 display: block;
        }

        .imgdetails {
            width: 80%;
            height: auto;
            margin-bottom: var(--XL-);
        }

        .imgsmall {
            display: flex;
            flex-direction: row;
            max-width: fit-content;
        }
    
        .naturfonden {
            font-weight: 700;
            padding: clamp(8px, 1.5vw, 15px) clamp(18px, 3vw, 40px);
            margin-top: var(--XL-);
    }
    }

</style>
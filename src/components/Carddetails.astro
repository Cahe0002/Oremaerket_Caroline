---
const { dankort } = Astro.props;
import Button from "./Button.astro";
---

<section>
    <div>
    <img src={dankort.image} alt={dankort.place} fetchpriority="high" class="imgdetails">
        <div class="small">
    <img src={dankort.img_1} alt={dankort.place} class="imgsmall" width="157">
    <img src={dankort.img_2} alt={dankort.place} class="imgsmall" width="157">
    <img src={dankort.img_3} alt={dankort.place} class="imgsmall" width="157">
    </div>
    </div>
    <div>
   <h1 class="h1">{dankort.place} - {dankort.city}</h1>
   <p class="p">{dankort.text_1}</p>
   <p class="p">{dankort.text_2}</p>
   <p class="p">{dankort.text_3}</p>
    <Button variant="secondary" title= "GÅ TIL NATURFONDEN" aria-label="Gå til naturfonden" href={dankort.link} target="_blank"></Button>
    <img src="/assets/SVG/filtrering_desktop/bi_filtrering_desktop_new.svg" alt="svg bi" class="beesvg">

   </div>
   
</section>

<section class="others">
    <h2 class="h2">Andre kiggede på</h2>
</section>


<style>
    section{
        display: grid;
        margin: 0 var(--S-);
        margin-top: var(--M-);
    }

    .beesvg {
  width: 100%;
  height: auto;
  margin-top: var(--L-);
}

    .tree {
  display: flex;
  flex-direction: row;
  justify-content: end;

}

.p {
    margin-bottom: var(--S-);
}

    .imgdetails {
        border-radius: 20px;
        width: 100%;
        aspect-ratio: 1/1;
        height: auto;
        object-fit: cover;
    }

    .small {
        display: grid;
        width: 100%;
        grid-template-columns: repeat(3, 1fr);
        border-radius: 20px;
        margin-top: var(--XS-);
        margin-bottom: var(--M-);
        gap: var(--S-);
    }

    .imgsmall {
        width: 100%;
        border-radius: var(--S-);
    }


        
 @media (min-width: 1024px) {

    section {
    grid-template-columns: repeat(2, 1fr);
    margin: 0 120px;
    margin-top: var(--L-);
    margin-bottom: var(--L-);
        
            }

              .others{
        margin-bottom: 0px;
    }
    

        .imgdetails {
            width: 80%;
            height: auto;
        }

        .beesvg {
             margin-left: var(--M-);
             width: 120%;
             display: block;
        }

            .small {
        display: grid;
        width: 80%;
        grid-template-columns: repeat(3, 1fr);
        border-radius: 20px;
        margin-top: var(--S-);
        gap: var(--S-);
    }

        .naturfonden {
            font-weight: 700;
            padding: clamp(8px, 1.5vw, 15px) clamp(18px, 3vw, 40px);
            margin-top: var(--XL-);
    }
    }

</style>
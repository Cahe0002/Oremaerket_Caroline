---
const { dankort } = Astro.props;
---
<article data-type={dankort.region}>
  <h4 class="h4">{dankort.place}</h4>
  <h4 class="h4 city">{dankort.city}</h4>
  
  <div>
    <img src={dankort.image} alt={dankort.place} class="natureimg">
    <div class="overlay">
      <img src={dankort.svg} alt="svg animation" loading="lazy" class="svgimg">
    </div>
  </div>

  <a href={`/details/${dankort.id}`}>
    <button class="p">LÆS MERE</button>
  </a>
</article>

<style>
    article{
       margin: 0 auto;
       position: relative;
    }


    .h4 {
        position: absolute;
        top: 1.4rem;
        left: 1.6rem;
        color: var(--dankort-hvid);
        z-index: 3;
        white-space: nowrap;
    }

    .city {
         top: 3rem;
        font-weight: 200;
    }

  button, .p {
    display: flex;
  position: absolute;
  transform: translateX(-50%);
  left: 50%;
  bottom: 8%;
  font-weight: bold;
  padding: 15px 40px;
  border-radius: 20px;
  color: var(--dankort-hvid);
  background: var(--dankort-roed);
  border: none;
  cursor: pointer;
  z-index: 4;
  white-space: nowrap;
    }

button:hover {
  background-color:#BD191C;
}

    .overlay {
        display: flex;
    justify-content: center;
    align-items: center;
    position: absolute;
    inset: 0; /* Shortcut for setting all four sides top,right,bottom,left */
    border-radius: 20px;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.5) 12%,
      rgba(30, 30, 30, 0.5) 22%,
      rgba(255, 255, 255, 0) 100%
    );
    z-index: 2;
    }

       .overlay:hover {
       background: none;
       }
    
        .natureimg {
        display: block;
        height:auto;
        width: 100%;
        border-radius: 20px;
        z-index: 1;
        object-fit: cover;
        }

        article .svgimg {
        width: 100%;
        align-items: center;
        opacity: 1;
        clip-path: inset(0 0 100% 0); 
        transition: clip-path 2s ease-in, opacity 1s ease;
        }

         article:hover .svgimg {
        clip-path: inset(0 0 0% 0);
        }

        article:not(:hover) .svgimg {
        opacity: 0;
       }

        .hide {
         display: none;
       }

        
 @media (min-width: 800px) {

    article {
                margin: 0px;
            }
            
button, .p {
  font-weight: 700;
   padding: clamp(8px, 1.5vw, 15px) clamp(18px, 3vw, 40px);
    }
        }

</style>